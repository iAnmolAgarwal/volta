# Copy to .env and fill in. Never commit .env.

# QuickML published endpoint
QUICKML_ENDPOINT_URL=
QUICKML_ENDPOINT_KEY=

# Catalyst project and Zoho OAuth (server side only)
CATALYST_ORG=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Proxy that forwards predict requests to QuickML
PREDICT_PROXY_URL=
