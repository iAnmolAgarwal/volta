# Copy to .env and fill in. Never commit .env.
# Load into your shell before running predict.py:  set -a; source .env; set +a
#
# predict.py picks its transport in this order:
#   1. PREDICT_PROXY_URL, if set
#   2. direct QuickML, if QUICKML_ENDPOINT_URL is set (needs every QuickML/Zoho value below)
#   3. DEFAULT_PROXY_URL in model/quickml_client.py (our AppSail route, once deployed)
# With none of these it exits with an error. It never falls back to a made-up curve.

# Proxy that forwards predict requests to QuickML (our AppSail route; no credentials)
PREDICT_PROXY_URL=

# Direct QuickML access (deployment URL and key from the endpoint's details page)
QUICKML_ENDPOINT_URL=
QUICKML_ENDPOINT_KEY=
CATALYST_ORG=
# Development or Production (sent as the Environment header; default Production)
QUICKML_ENVIRONMENT=

# Zoho OAuth for direct access. Self Client with scope QuickML.deployment.READ;
# access tokens come from https://accounts.zoho.in/oauth/v2/token
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Request tuning (defaults shown)
QUICKML_BATCH_SIZE=1
QUICKML_TIMEOUT=15
QUICKML_RETRIES=3
