# Copy to .env and fill in. Never commit .env.
# Load into your shell:  set -a; source .env; set +a
#
# predict.py needs none of this: it posts to DEFAULT_PROXY_URL (our AppSail
# service). PREDICT_PROXY_URL only overrides that URL, for local testing.
PREDICT_PROXY_URL=

# --- AppSail proxy (backend/app.py) -------------------------------------------
# On Catalyst these are AppSail environment variables set in the console, not
# a file.
#
# Inside AppSail only QUICKML_ENDPOINT_KEY is needed: the Catalyst SDK
# authenticates from the gateway's request headers. The rest below is for
# direct REST access (outside Catalyst, or once the endpoint is published).
QUICKML_ENDPOINT_KEY=

# Direct REST: the deployment URL appears on the endpoint's details page after publishing
QUICKML_ENDPOINT_URL=
# Catalyst org ID, sent as the CATALYST-ORG header. (AppSail reserves CATALYST* names.)
ZOHO_ORG_ID=
# Development or Production (sent as the Environment header; default Production)
QUICKML_ENVIRONMENT=

# Zoho OAuth: Self Client with scope QuickML.deployment.READ.
# scripts/zoho_auth.py turns a grant code into ZOHO_REFRESH_TOKEN here.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Request tuning (defaults shown)
QUICKML_BATCH_SIZE=1000
QUICKML_CONCURRENCY=8
QUICKML_TIMEOUT=15
QUICKML_RETRIES=3
